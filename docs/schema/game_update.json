{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Update Event",
  "description": "Periodic game state update sent every second",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "game_update"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was created"
    },
    "data": {
      "$ref": "common/game_info.json",
      "description": "Complete game state information"
    }
  },
  "required": ["type", "data", "timestamp"],
  "additionalProperties": false
}