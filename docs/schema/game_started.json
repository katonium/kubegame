{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Started Event",
  "description": "Game started confirmation event",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "game_started"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was created"
    },
    "data": {
      "$ref": "common/game_info.json",
      "description": "Complete game state information when game starts"
    }
  },
  "required": ["type", "data", "timestamp"],
  "additionalProperties": false
}