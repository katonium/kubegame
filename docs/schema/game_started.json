{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Started Event",
  "description": "Game started confirmation event",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "game_started"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was created"
    },
    "data": {
      "type": "object",
      "properties": {
        "gameID": {
          "type": "string",
          "description": "Unique identifier for the game instance"
        },
        "timeLeft": {
          "type": "integer",
          "minimum": 0,
          "description": "Time remaining in seconds (default 300 seconds)"
        }
      },
      "required": ["gameID", "timeLeft"],
      "additionalProperties": false
    }
  },
  "required": ["type", "data", "timestamp"],
  "additionalProperties": false
}