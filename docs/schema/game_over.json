{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Over Event",
  "description": "Game ended event when timer expires",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "game_over"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was created"
    },
    "data": {
      "type": "object",
      "properties": {
        "playerScore": {
          "type": "integer",
          "minimum": 0,
          "description": "Final score for the player"
        },
        "cpuScore": {
          "type": "integer",
          "minimum": 0,
          "description": "Final score for the Kubernetes scheduler"
        }
      },
      "required": ["playerScore", "cpuScore"],
      "additionalProperties": false
    }
  },
  "required": ["type", "data", "timestamp"],
  "additionalProperties": false
}