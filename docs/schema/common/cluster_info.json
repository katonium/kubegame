{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cluster_info.json",
  "title": "Cluster Information",
  "description": "Information about a cluster including its pods and nodes",
  "type": "object",
  "properties": {
    "pods": {
      "type": "array",
      "description": "Current state of all pods in the cluster",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique pod identifier"
          },
          "name": {
            "type": "string",
            "description": "Pod name"
          },
          "label": {
            "$ref": "pod_labels.json",
            "description": "Pod label/type"
          },
          "affinity": {
            "$ref": "affinity.json",
            "description": "Pod-specific affinity rules"
          },
          "requirements": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number",
                "minimum": 0,
                "description": "CPU requirement in cores"
              },
              "memory": {
                "type": "number",
                "minimum": 0,
                "description": "Memory requirement in bytes"
              }
            },
            "required": ["cpu", "memory"],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": ["pending", "scheduling", "scheduled", "unscheduled", "terminating"],
            "description": "Current pod status"
          },
          "nodeID": {
            "type": ["string", "null"],
            "description": "ID of the node the pod is scheduled to (null if pending)"
          }
        },
        "required": ["id", "name", "label", "affinity", "requirements", "status"],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "description": "Current state of all nodes in the cluster",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique node identifier"
          },
          "name": {
            "type": "string",
            "description": "Node name"
          },
          "type": {
            "type": "string",
            "enum": ["player", "scheduler"],
            "description": "Node type - player controllable or scheduler controlled"
          },
          "capacity": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number",
                "minimum": 0,
                "description": "Total CPU capacity in cores"
              },
              "memory": {
                "type": "number",
                "minimum": 0,
                "description": "Total memory capacity in bytes"
              }
            },
            "required": ["cpu", "memory"],
            "additionalProperties": false
          },
          "used": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number",
                "minimum": 0,
                "description": "Used CPU in cores"
              },
              "memory": {
                "type": "number",
                "minimum": 0,
                "description": "Used memory in bytes"
              }
            },
            "required": ["cpu", "memory"],
            "additionalProperties": false
          }
        },
        "required": ["id", "name", "type", "capacity", "used"],
        "additionalProperties": false
      }
    }
  },
  "required": ["pods", "nodes"],
  "additionalProperties": false
}
