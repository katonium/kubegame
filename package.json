{
  "name": "kubegame",
  "version": "1.0.0",
  "private": true,
  "description": "KubeGame - Kubernetes Scheduling Game",
  "scripts": {
    "generate:redoc": "tsx scripts/generate-redoc.ts",
    "test": "playwright test --config tests/playwright.config.ts",
    "test:api": "playwright test --config tests/playwright.config.ts --project=api-tests",
    "test:scenario": "playwright test --config tests/playwright.config.ts --project=scenario-tests",
    "test:ui": "playwright test --config tests/playwright.config.ts --ui",
    "test:debug": "playwright test --config tests/playwright.config.ts --debug",
    "test:headed": "playwright test --config tests/playwright.config.ts --headed",
    "test:report": "playwright show-report tests/test-results/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@redocly/cli": "^1.26.5",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
